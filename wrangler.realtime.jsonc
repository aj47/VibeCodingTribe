{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vibecodingtribe-realtime",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-18",
  "workers_dev": true,
  "triggers": {
    "crons": ["0 8 * * *"]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:4173,http://127.0.0.1:4173,https://vibecodingtribe.com,https://vibecodingtribe.pages.dev",
    "AUTH_APP_ORIGIN": "https://vibecodingtribe.com",
    "EMAIL_UNSUBSCRIBE_ORIGIN": "https://vibecodingtribe-realtime.techfren.workers.dev",
    "EMAIL_FROM": "Vibe Coding Tribe <updates@notifications.vibecodingtribe.com>"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "vibecodingtribe-media",
      "preview_bucket_name": "vibecodingtribe-media-preview"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_ROOM",
        "class_name": "RealtimeRoom"
      },
      {
        "name": "EXCHANGE_STATE",
        "class_name": "ExchangeStore"
      },
      {
        "name": "ACCOUNTS",
        "class_name": "AccountStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RealtimeRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ExchangeStore"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["AccountStore"]
    }
  ]
}
