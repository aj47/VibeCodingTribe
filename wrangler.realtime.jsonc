{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vibecodingtribe-realtime",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-18",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:4173,http://127.0.0.1:4173,https://vibecodingtribe.pages.dev"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_ROOM",
        "class_name": "RealtimeRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RealtimeRoom"]
    }
  ]
}
